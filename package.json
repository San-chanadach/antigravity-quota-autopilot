{
  "name": "antigravity-quota-autopilot",
  "displayName": "Antigravity AI Quota & Auto-Accept Autopilot",
  "description": "Real-time AI model quota monitor (Free/Pro/Ultra/Gemini 4 Argon), native Turbo Autopilot & Agent Behavior controller, and activity logger for Google Antigravity IDE v2.6.0+.",
  "version": "1.2.1",
  "publisher": "san-chanadach",
  "author": "San Chanadach",
  "license": "MIT",
  "sponsor": {
    "url": "https://ko-fi.com/sanchanadach"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/San-chanadach/antigravity-quota-autopilot.git"
  },
  "bugs": {
    "url": "https://github.com/San-chanadach/antigravity-quota-autopilot/issues"
  },
  "homepage": "https://github.com/San-chanadach/antigravity-quota-autopilot#readme",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Productivity"
  ],
  "keywords": [
    "antigravity",
    "gemini",
    "argon",
    "claude",
    "gpt",
    "quota",
    "limit",
    "monitor",
    "autopilot",
    "turbo",
    "permissions",
    "status bar"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antigravityLimitMonitor.openQuickMenu",
        "title": "Open Autopilot & Quota Quick Menu",
        "category": "Antigravity Autopilot"
      },
      {
        "command": "antigravityLimitMonitor.toggleTurbo",
        "title": "Toggle Turbo Autopilot (ON/OFF)",
        "category": "Antigravity Autopilot",
        "icon": "$(zap)"
      },
      {
        "command": "antigravityLimitMonitor.setPermissionPreset",
        "title": "Set Global Permissions (Turbo / Default / Request Review)",
        "category": "Antigravity Autopilot",
        "icon": "$(shield)"
      },
      {
        "command": "antigravityLimitMonitor.setPlanReviewPolicy",
        "title": "Set Plan Review Policy (Always Proceed / Always Ask)",
        "category": "Antigravity Autopilot",
        "icon": "$(checklist)"
      },
      {
        "command": "antigravityLimitMonitor.showDashboard",
        "title": "Show Quota & Autopilot Dashboard",
        "category": "Antigravity Autopilot",
        "icon": "$(graph)"
      },
      {
        "command": "antigravityLimitMonitor.refresh",
        "title": "Refresh Model Quota Limits",
        "category": "Antigravity Autopilot",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityLimitMonitor.toggleDisplayMode",
        "title": "Switch Status Bar Display Mode",
        "category": "Antigravity Autopilot"
      },
      {
        "command": "antigravityLimitMonitor.showLogs",
        "title": "Show Limit Monitor Logs",
        "category": "Antigravity Autopilot",
        "icon": "$(output)"
      },
      {
        "command": "antigravityLimitMonitor.clearHistory",
        "title": "Clear Activity History Logs",
        "category": "Antigravity Autopilot",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravityLimitMonitor.openQuickMenu",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-limit-monitor",
          "title": "Model Limits",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-limit-monitor": [
        {
          "id": "antigravityLimitMonitorView",
          "name": "Usage Limits"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "antigravityLimitMonitor.refresh",
          "when": "view == antigravityLimitMonitorView",
          "group": "navigation@1"
        },
        {
          "command": "antigravityLimitMonitor.showDashboard",
          "when": "view == antigravityLimitMonitorView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Quota & Autopilot",
      "properties": {
        "antigravityLimitMonitor.refreshIntervalSeconds": {
          "type": "integer",
          "default": 10,
          "minimum": 3,
          "maximum": 600,
          "description": "Interval in seconds to refresh model quota limits from Antigravity Language Server."
        },
        "antigravityLimitMonitor.statusBarFormat": {
          "type": "string",
          "enum": [
            "all",
            "fiveHourOnly",
            "geminiOnly",
            "compact",
            "smartLowest"
          ],
          "enumDescriptions": [
            "Show all active model groups dynamically (e.g. Gemi: 95% | Cl: 100% | Ar: 32%)",
            "Prefer 5-hour limits when available, and weekly limits for weekly-only models (e.g. Gemini 4 Argon)",
            "Show Gemini & Argon model groups only",
            "Compact mode with lowest remaining percentage (e.g. Quota: 32% (Ar))",
            "Smart mode: highlights only the model group with the lowest remaining quota"
          ],
          "default": "all",
          "description": "Display format for the status bar item."
        },
        "antigravityLimitMonitor.showStatusAlertColors": {
          "type": "boolean",
          "default": true,
          "description": "Highlight status bar text with warning/error colors when quota drops low."
        },
        "antigravityLimitMonitor.lowQuotaWarningThreshold": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "maximum": 50,
          "description": "Show warning notification when any model limit drops below this percentage (0 to disable)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
